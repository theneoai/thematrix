#!/bin/bash
#
# TheMatrix CLI Wrapper
# 用法: ./matrix [命令] [选项]
#
# 这个脚本会自动检测并使用正确的运行方式
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI_DIST="$SCRIPT_DIR/apps/cli/dist/index.js"

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 检查是否在正确的目录
if [ ! -f "$SCRIPT_DIR/package.json" ]; then
    echo -e "${RED}Error: 请在项目根目录运行此脚本${NC}"
    exit 1
fi

# 检查构建文件是否存在
if [ ! -f "$CLI_DIST" ]; then
    echo -e "${YELLOW}CLI 未构建，正在构建...${NC}"
    if command -v pnpm &> /dev/null; then
        cd "$SCRIPT_DIR"
        pnpm build
    else
        echo -e "${RED}Error: 未找到 pnpm，请先安装依赖${NC}"
        exit 1
    fi
fi

# 运行 CLI
exec node "$CLI_DIST" "$@"
