{
  "name": "@thematrix/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "matrix": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@thematrix/types": "workspace:*",
    "@thematrix/utils": "workspace:*",
    "@thematrix/config": "workspace:*",
    "@thematrix/core": "workspace:*",
    "@thematrix/adapters": "workspace:*",
    "commander": "^13.0.0",
    "chalk": "^5.4.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  }
}
